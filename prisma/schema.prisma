// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(cuid())
  email       String
  phoneNumber String
  firstName   String
  lastName    String
  password    String
  country     String?
  city        String?
  state       String?
  zipCode     String?
  address     String?
  bio         String?
  gender      Gender?
  meta        UserMeta[]
  isVerified  Boolean    @default(false)
  profile     Profile    @default(STUDENT)
  status      Status     @default(INACTIVE)

  referralCode String?
  referrerId   String?
  referrer     User?          @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referees     User[]         @relation("ReferrerRelation")
  salary       Salary[]
  commission   Commission[]
  balance      Balance[]
  notification Notification[]
  nodes        Node[]         @relation("Nodes")
  mappers      Node[]         @relation("Mappers")
  mapped       Node[]         @relation("Mapped")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, profile])
  @@unique([phoneNumber, profile])
}

enum Profile {
  STUDENT
  TRAINER
  COUNSELOR
  CONTROLLER
  ADMIN
  SUPER_ADMIN
}

model UserMeta {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String

  user User? @relation(fields: [userId], references: [id])
}

enum Status {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
  BLOCKED
  DRAFT
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

model Salary {
  id     String @id @default(cuid())
  userId String
  amount Float

  user User @relation(fields: [userId], references: [id])
}

model Commission {
  id         String @id @default(cuid())
  userId     String
  commission Float  @default(0.0)

  user User @relation(fields: [userId], references: [id])
}

model Balance {
  id        String   @id @default(cuid())
  userId    String
  amount    Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactionsOutgoing Transaction[] @relation("PayerTransactions")
  transactionsIncoming Transaction[] @relation("PayeeTransactions")
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float    @default(0.0)
  reason    String?
  details   Json?
  status    String?
  payerId   String
  payeeId   String
  createdAt DateTime @default(now())

  payer Balance @relation("PayerTransactions", fields: [payerId], references: [id])
  payee Balance @relation("PayeeTransactions", fields: [payeeId], references: [id])
}

model Node {
  id       String @id @default(cuid())
  nodeId   String
  mapperId String
  mappedId String

  node   User @relation("Nodes", fields: [nodeId], references: [id], map: "Node_nodeId_fkey")
  mapper User @relation("Mappers", fields: [mapperId], references: [id], map: "Node_mapperId_fkey")
  mapped User @relation("Mapped", fields: [mappedId], references: [id], map: "Node_mappedId_fkey")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  message   String
  details   Json?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
}
